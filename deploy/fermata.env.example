# Fermata hosted demo settings (/etc/fermata/fermata.env, read by fermata.service).
# Keys are not here: they live in /opt/fermata/.env (pnpm keys:init, or your Moderato .env).

# Public mode: Try it buttons, self-serve onboarding.
PUBLIC=1
# The gateway sits behind Caddy on this machine: rate limits use X-Forwarded-For.
GATEWAY_TRUST_PROXY=1
# The public host name (bootstrap.sh fills both in).
GATEWAY_REALM=
FERMATA_DOMAIN=
# Calls, proofs and onboarded vendors survive restarts here.
FERMATA_STATE_DIR=/var/lib/fermata/state
# Real third-party vendors next to the mock ones (each passed scripts/probe-tls.sh; drop one if its provider blocks your host).
REAL_VENDORS=npm,coinbase,mempool,kraken
# Demo limits.
DEMO_PER_IP_SECONDS=60
DEMO_PER_IP_PER_DAY=15
DEMO_DAILY_CAP=500
# Most the demo agent pays for one call to an onboarded service (base units: 10000 = 0.01).
DEMO_MAX_PRICE=10000
# Per-visitor requests per minute to the paid routes and to proof re-verification.
GATEWAY_RATE_PER_MIN=120
GATEWAY_VERIFY_RATE_PER_MIN=10
# Self-serve listings: 1 refuses a listing whose lister has not proved control of the API's host
# (a TXT record at _fermata.<host> = fermata-payout=<payout>, or /.well-known/fermata.json). Default 0:
# unverified listings are allowed and labelled "owner not verified".
ONBOARD_REQUIRE_OWNER_PROOF=0
