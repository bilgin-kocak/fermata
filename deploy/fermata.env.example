# Fermata hosted demo settings (/etc/fermata/fermata.env, read by fermata.service).
# Keys are not here: they live in /opt/fermata/.env (pnpm keys:init, or your Moderato .env).

# Public mode: Try it buttons, self-serve onboarding.
PUBLIC=1
# The gateway sits behind Caddy on this machine: rate limits use X-Forwarded-For.
GATEWAY_TRUST_PROXY=1
# The public host name (bootstrap.sh fills both in).
GATEWAY_REALM=
FERMATA_DOMAIN=
# Calls, proofs and onboarded vendors survive restarts here.
FERMATA_STATE_DIR=/var/lib/fermata/state
# Real third-party vendors next to the mock ones (npm works anywhere; add coinbase after probe-tls.sh passes).
REAL_VENDORS=npm
# Demo limits.
DEMO_PER_IP_SECONDS=60
DEMO_PER_IP_PER_DAY=15
DEMO_DAILY_CAP=500
