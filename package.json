{
  "name": "fermata",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Fermata — pay on proof: escrowed machine payments on Tempo, released on TLSNotary evidence",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "dev": "bash scripts/demo-stack.sh up --chain anvil",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test && FOUNDRY_PROFILE=tempo forge test --network tempo",
    "sdk:test": "pnpm -F @fermata/sdk test",
    "test": "pnpm contracts:test && pnpm sdk:test",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -F @fermata/sdk typecheck && pnpm -F @fermata/gateway typecheck && pnpm -F @fermata/mcp typecheck",
    "keys:init": "tsx scripts/keys-init.ts",
    "escrow:deploy": "bash scripts/deploy-escrow.sh",
    "escrow:roundtrip": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA tsx scripts/escrow-roundtrip.ts",
    "escrow:e2e:anvil": "bash scripts/e2e-anvil.sh",
    "attest:test": "cd apps/attestor && cargo +1.95.0 test --release && cargo +1.95.0 test --release --test attest attestor_end_to_end -- --ignored",
    "attest:e2e:anvil": "bash scripts/e2e-attest.sh",
    "gateway:test": "pnpm -F @fermata/gateway test",
    "gateway:e2e:anvil": "bash scripts/e2e-gateway.sh",
    "demo:up": "bash scripts/demo-stack.sh up",
    "demo:down": "bash scripts/demo-stack.sh down",
    "demo:cases": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA tsx scripts/demo/cases.ts",
    "demo:agent": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA tsx scripts/demo/agent.ts",
    "demo:load": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA tsx scripts/demo/agent.ts --service quote --load",
    "service:register": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA tsx scripts/register-service.ts",
    "demo:mcp": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA tsx scripts/demo/mcp.ts",
    "demo:real": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA tsx scripts/demo/real.ts",
    "demo:onboard": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA tsx scripts/demo/onboard.ts",
    "scores": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA tsx scripts/scores.ts",
    "fund": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA tsx scripts/fund.ts",
    "mcp": "tsx apps/mcp/src/index.ts",
    "reverify": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA tsx scripts/reverify.ts"
  },
  "devDependencies": {
    "@fermata/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@types/node": "^22.19.0",
    "mppx": "0.11.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "viem": "^2.56.8"
  }
}
