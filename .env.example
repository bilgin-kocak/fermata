# Fermata environment. Copy to .env (or run `pnpm keys:init`, which creates .env with fresh
# testnet keys and never overwrites existing values). TESTNET ONLY — never put a key that holds
# real funds here. .env is git-ignored.

# --- Tempo network -----------------------------------------------------------------------------
# Moderato testnet RPC (chain id 42431). Explorer: https://explore.testnet.tempo.xyz
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# --- Escrow deployment (contracts/script/Deploy.s.sol) -----------------------------------------
# Deployer key. Fund it with: cast rpc tempo_fundAddress <address> --rpc-url $TEMPO_RPC_URL
DEPLOYER_PRIVATE_KEY=
# Escrow owner (can change the fee and treasury). Defaults to the deployer address.
FERMATA_OWNER=
# Treasury that receives the release fee. Defaults to the deployer address.
FERMATA_TREASURY=
# Release fee in basis points (never charged on refunds). Default 50 = 0.5 %, contract cap 500.
FERMATA_FEE_BPS=50

# --- Roles used by the scripts, gateway and demo -----------------------------------------------
# Verifier key that signs EIP-712 verdicts (the Fermata attestor, Milestone 2).
VERIFIER_PRIVATE_KEY=
# Relayer key that submits settle() transactions (the gateway, Milestone 3).
RELAYER_PRIVATE_KEY=
# Vendor key that registers services and receives payouts (demo vendor).
VENDOR_PRIVATE_KEY=
# Agent key that buys calls (demo agent, Milestone 4). The escrow round-trip script ignores it and
# always uses a fresh agent funded by the deployer.
AGENT_PRIVATE_KEY=

# --- Attestor, notary and gateway (Milestones 2-3) ----------------------------------------------
# Deployed escrow the attestor and gateway serve (defaults to deployments.json in the scripts).
FERMATA_ESCROW=
# Notary signing key (dev notary run by Fermata; the verifier pins its keccak256 as notaryKeyHash).
NOTARY_PRIVATE_KEY=
# Attestor HTTP API used by the gateway.
ATTESTOR_URL=http://127.0.0.1:7048
# mppx HMAC secret for the gateway's challenges (at least 32 bytes; keys:init fills it).
GATEWAY_SECRET_KEY=
# Upstream API credential the gateway sends to the vendor (value redacted in every proof).
VENDOR_UPSTREAM_TOKEN=
# HTTP CONNECT proxy the attestor uses to reach real vendors (defaults to HTTPS_PROXY in
# demo-stack.sh; empty = connect directly). The notary connection never uses it.
FERMATA_UPSTREAM_PROXY=
# Real third-party vendors demo-stack.sh registers next to the mock ones: npm, coinbase (comma-separated; empty = none).
REAL_VENDORS=npm

# --- Hosted public demo (gateway public mode; deploy/README.md) -----------------------------------
# 1: scripts/demo-stack.sh starts the gateway in public mode (POST /demo/call and GET /demo/status for
# the "Try it" buttons, /onboard/* for self-serve listing). Off by default. (The gateway itself reads
# GATEWAY_PUBLIC, which demo-stack.sh sets from this.)
PUBLIC=0
# Testnet key of the server-side demo agent that pays for visitors' demo calls (empty: AGENT_PRIVATE_KEY).
DEMO_AGENT_PRIVATE_KEY=
# Key that registers onboarded vendors' services (their serviceId starts with its address; empty = the relayer key).
ONBOARD_OPERATOR_PRIVATE_KEY=
# Where onboarding writes predicates and the services it added (demo-stack.sh sets both under FERMATA_STATE_DIR).
ONBOARD_PREDICATE_DIR=
ONBOARD_SERVICES_FILE=
# Persistent state for a hosted deployment: calls, presentations, onboarded predicates and services.
FERMATA_STATE_DIR=
# The gateway's public host name (MPP realm), e.g. fermata.example.com or 1-2-3-4.sslip.io.
GATEWAY_REALM=
# Proxies in front of the gateway that append to X-Forwarded-For (0 = none, Caddy = 1, Railway = 2):
# rate limits key on the entry that many from the right; anything further left is client-supplied.
GATEWAY_TRUST_PROXY=0
# Demo limits: seconds between calls per visitor, calls per visitor per day, and calls per UTC day.
DEMO_PER_IP_SECONDS=60
DEMO_PER_IP_PER_DAY=15
DEMO_DAILY_CAP=500
# Proofs in flight before new payers get 503 (nothing charged). The attestor proves one call at a time.
GATEWAY_MAX_IN_FLIGHT=4
# First block the gateway scans for escrow events (live feed, vendor scores). Empty: the escrow's deploy
# block from packages/sdk/src/deployments.json.
GATEWAY_FROM_BLOCK=

# --- MCP agent (apps/mcp, fermata-mcp) ----------------------------------------------------------
# Gateway the agent's MCP server connects to, and the agent's TESTNET key (fund it from the faucet).
FERMATA_GATEWAY=http://127.0.0.1:4300
FERMATA_AGENT_KEY=
# Verifier address(es) and escrow(s) the agent trusts (never taken from the gateway); network for the default escrow.
FERMATA_TRUSTED_VERIFIERS=
FERMATA_NETWORK=moderato
# Spending guard, in token base units: max price per call, max total held per session.
FERMATA_MAX_PRICE=100000
FERMATA_BUDGET=1000000
