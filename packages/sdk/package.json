{
  "name": "fermata-sdk",
  "version": "0.1.0",
  "description": "Pay on proof for AI agents: the `fermata` MPP payment method (agent and server side), escrow bindings on Tempo, reconciliation by memo and vendor scores.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "tempo",
    "mpp",
    "tlsnotary",
    "escrow",
    "ai-agents",
    "agent-payments",
    "stablecoin",
    "mcp",
    "x402"
  ],
  "homepage": "https://github.com/bilgin-kocak/fermata/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilgin-kocak/fermata.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/bilgin-kocak/fermata/issues",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./deployments.json": "./src/deployments.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./deployments.json": "./dist/deployments.json"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "viem": "^2.56.8"
  },
  "peerDependencies": {
    "mppx": "~0.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1",
    "mppx": "0.11.0"
  }
}
